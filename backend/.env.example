# Backend-only environment variables. Never commit real secrets.
# Fill these in locally in your own untracked backend/.env — do not put
# real values in this .example file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ENVIRONMENT=development
APP_NAME=ManakMitra API
APP_VERSION=0.1.0

# Operations endpoints: required for /ops/* in production.
# Generate a fresh random token, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_ADMIN_TOKEN=

# AI #1
LLM_API_KEY=
LLM_API_KEY_2=
LLM_API_KEY_3=
LLM_API_KEY_4=
LLM_MODEL=gemini-3.6-flash

# AI #2 (optional dedicated fallback keys; if blank, AI #1 keys are reused)
AI2_API_KEY=
AI2_API_KEY_2=
AI2_API_KEY_3=
AI2_API_KEY_4=
AI2_MODEL=gemini-3.6-flash

# Phase 8 — usage protection / cost control
MAX_MESSAGE_LENGTH=10000
MAX_REQUEST_SIZE_BYTES=32768
MAX_CONTEXT_SIZE_CHARS=24000
MAX_OUTPUT_TOKENS=2048
# Gemini network timeout/retry protection for grounded responses
LLM_REQUEST_TIMEOUT_MS=30000
LLM_TRANSIENT_RETRIES=1
# Max Gemini calls per generate() across all keys+retries (was effectively 8)
LLM_MAX_CALLS_PER_GENERATE=2
MAX_AI1_CALLS_PER_REQUEST=1
MAX_AI2_CALLS_PER_REQUEST=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_IP=60
RATE_LIMIT_CHAT_PER_IP=10
RATE_LIMIT_SEARCH_PER_IP=30

# Phase 9 — scheduled maintenance (disabled by default)
SCHEDULER_ENABLED=false
BIS_SYNC_ENABLED=false
BIS_SYNC_INTERVAL=86400
BIS_SYNC_RETRIES=1
CACHE_CLEANUP_INTERVAL=3600
USAGE_STATS_INTERVAL=3600
TEMPORARY_DATA_CLEANUP_INTERVAL=3600

# Phase 10 — semantic embeddings / pgvector
# Gemini Embedding 2 is the default provider. 768 is the Phase 10 pgvector dimension.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_INPUT_CHARS=12000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RETRIES=2

# Hybrid ranking weights (automatically normalized if their sum is not 1).
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.35
HYBRID_METADATA_WEIGHT=0.10
VECTOR_MIN_SIMILARITY=0.0

# Phase 19 — document intelligence
DOCUMENT_STORAGE_ROOT=backend/storage/documents
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_OCR_ENABLED=true

# Phase 23 — certification application email (optional but required for real email delivery)
# Example SMTP settings. Use an app password for providers that require one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
